# Скопируйте в .env и заполните нужное. Всё это можно задать и в интерфейсе: Настройки → Подключения.

# OpenRouter — сотни облачных моделей по одному ключу: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama — локальные модели (по умолчанию http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Любой OpenAI-совместимый сервер: LM Studio, vLLM, llama.cpp…
# CUSTOM_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_OPENAI_API_KEY=

# Свой SearXNG для веб-поиска (иначе используется DuckDuckGo)
# SEARXNG_URL=http://127.0.0.1:8888

# Рабочая папка моделей по умолчанию (по умолчанию ./workspace). Удобнее задать в
# интерфейсе: Настройки → Рабочая папка и терминал
# HEPHAESTUS_WORKSPACE=./workspace

# Терминал для моделей: off (по умолчанию) или full — любые команды в рабочей папке.
# Настройка в интерфейсе важнее этой переменной.
# HEPHAESTUS_TERMINAL=off
# HEPHAESTUS_COMMAND_TIMEOUT=120

# Имена хостов через запятую, с которых можно открывать приложение кроме localhost
# (например, из локальной сети). API отвечает только им.
# HEPHAESTUS_ALLOWED_HOSTS=my-pc.lan

# Часовой пояс, который сообщается моделям вместе с текущей датой
# TZ=Europe/Moscow
